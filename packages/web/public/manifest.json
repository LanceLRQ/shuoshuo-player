{
  "manifest_version": 3,
  "name": "说说播放器-水晶蟹定制版",
  "version": "2.0.1",
  "description": "说说播放器是一款基于Bilibili的第三方音乐播放器，可以将说宝B站视频投稿变成你的歌单，沉浸式享受音乐盛宴",
  "icons": {
    "16": "logo16.png",
    "48": "logo48.png",
    "128": "logo128.png"
  },
  "action": {
    "default_icon": {
      "16": "logo16.png",
      "48": "logo48.png",
      "128": "logo128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.acgvideo.com/*",
    "*://*.bilivideo.com/*",
    "*://*.bilivideo.cn/*",
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*",
    "*://*.akamaized.net/*",
    "*://*.mountaintoys.cn/*",
    "*://shuoshuo.sikong.ren/*",
    "*://download.hutao.wiki/*",
    "*://api.github.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shuoshuo_player_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
