{
  "manifest_version": 3,
  "name": "说说播放器",
  "version": "2.0.0",
  "description": "基于 Bilibili 的第三方音乐播放器 - 水晶蟹定制版",
  "icons": {
    "16": "logo16.png",
    "48": "logo48.png",
    "128": "logo128.png"
  },
  "action": {
    "default_icon": {
      "16": "logo16.png",
      "48": "logo48.png",
      "128": "logo128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "*://*.acgvideo.com/*",
    "*://*.bilivideo.com/*",
    "*://*.bilivideo.cn/*",
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*",
    "*://*.cgvideo.com/*",
    "*://*.akamaized.net/*",
    "*://*.mountaintoys.cn/*",
    "*://*.y.qq.com/*",
    "*://shuoshuo.sikong.ren/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shuoshuo_player_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
